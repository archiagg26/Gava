# GharSetu Environment Configuration Template
# Copy this file to .env and provide your credentials (if available).
# Note: GharSetu operates fully in offline / demo mode if keys are not provided!

# 1. Google Gemini AI API Key (Optional)
# If provided, powers live dynamic answers in AI Sahayak.
# If omitted or empty, the platform seamlessly uses its grounded offline knowledge engine.
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# 2. Supabase Configuration (Optional)
# If provided, synchronizes user profile, document metadata, and milestones to PostgreSQL.
# If omitted, GharSetu uses client-side safe local persistence and pre-configured demo workflows.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
